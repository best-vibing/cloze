# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.
CLOZE_GEMINI_API_KEY=
CLOZE_GEMINI_MODEL=gemini-3.5-flash-lite
CLOZE_GEMINI_TIMEOUT_S=60
# 기준 PDF 세트가 있는 로컬 폴더(레포 밖)
CLOZE_SAMPLES_DIR=
# 로컬 개발은 기본값(docker-compose.yml의 postgres)을 쓰므로 주석으로 둔다. 포트를 바꿨거나 운영이면 주석을 풀고 고친다.
# CLOZE_DATABASE_URL=postgresql+psycopg://cloze:cloze@127.0.0.1:5432/cloze
