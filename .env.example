# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.
CLOZE_GEMINI_API_KEY=
CLOZE_GEMINI_MODEL=gemini-3.5-flash-lite
CLOZE_GEMINI_TIMEOUT_S=60
# 기준 PDF 세트가 있는 로컬 폴더(레포 밖)
CLOZE_SAMPLES_DIR=
# 로컬 개발은 기본값(docker-compose.yml의 postgres)을 쓰므로 주석으로 둔다. 포트를 바꿨거나 운영이면 주석을 풀고 고친다.
# CLOZE_DATABASE_URL=postgresql+psycopg://cloze:cloze@127.0.0.1:5432/cloze
# 큐. 로컬은 기본값을 쓰므로 주석으로 둔다. 기본값은 cloze/config.py, 시간 규칙은 신뢰성 설계 2절.
# CLOZE_REDIS_URL=redis://127.0.0.1:6379/0
# CLOZE_TASK_TIMEOUT_S=
# CLOZE_QUEUE_IDLE_TIMEOUT_MS=
# 세션 쿠키 서명 키(필수, 32자 이상). 로컬도 각자 만든다: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOZE_SESSION_SECRET=
# https가 아닌 로컬 개발에서만 false로 둔다(쿠키 Secure 속성).
CLOZE_COOKIE_SECURE=false
# 가린 이미지 주소 서명 키(필수, 32자 이상, 세션 키와 다른 값). 만드는 법은 세션 키와 같다.
CLOZE_IMAGE_SIGNING_KEY=
# 이미지 주소 만료(초). 기본 900(15분, 신뢰성 설계 2절).
# CLOZE_IMAGE_URL_TTL_S=
# 업로드 원본 저장 폴더. 절대 경로만 받는다. 로컬은 기본값(레포의 data/storage)을 쓰므로 주석으로 둔다.
# CLOZE_STORAGE_DIR=
