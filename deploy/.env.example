# 시연 기기용. deploy/.env 로 복사해서 값을 채운다. deploy/.env 는 커밋하지 않는다.
# 비밀값은 아래 명령으로 만든다: python -c "import secrets; print(secrets.token_urlsafe(32))"

# 이미지 태그. 기본 develop. 특정 커밋으로 되돌릴 때는 sha-<커밋 해시 전체>로 바꾼다.
# CLOZE_IMAGE_TAG=develop

# DB 비밀번호. 아래 CLOZE_DATABASE_URL의 비밀번호 자리에도 같은 값을 넣는다.
POSTGRES_PASSWORD=
CLOZE_DATABASE_URL=postgresql+psycopg://cloze:<POSTGRES_PASSWORD>@postgres:5432/cloze
CLOZE_REDIS_URL=redis://redis:6379/0

CLOZE_GEMINI_API_KEY=

# 세션 쿠키 서명 키(32자 이상). 없으면 API가 뜨지 않는다(#34).
CLOZE_SESSION_SECRET=
# 공개 주소. Tailscale이 준 https 주소를 그대로 쓴다. 상태를 바꾸는 요청은 이 Origin에서만 받는다.
CLOZE_PUBLIC_ORIGIN=https://<기기 이름>.<tailnet 이름>.ts.net
# Tailscale이 https를 맡으므로 켠다.
CLOZE_COOKIE_SECURE=true
